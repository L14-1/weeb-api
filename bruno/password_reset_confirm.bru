meta {
  name: Password Reset Confirm
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/password-reset/confirm/
  body: json
  auth: none
}

body:json {
  {
    "uid": "{{resetUid}}",
    "token": "{{resetToken}}",
    "password": "NouveauMotDePasse1!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("password", req.body.password);
  }
}
